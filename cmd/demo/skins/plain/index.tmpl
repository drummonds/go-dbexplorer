{{- /* Plain skin: the overview as lists. Data: IndexView. */ -}}
{{define "index" -}}
<h2>Database</h2>
{{- if .Error}}<p><mark>{{.Error}}</mark></p>
{{- else if not .Tables}}<p>No tables found.</p>
{{- else -}}
<h3>Tables</h3><ul>{{range .Tables}}{{template "summary" .}}{{end}}</ul>
{{- with .Views}}<h3>Views</h3><ul>{{range .}}{{template "summary" .}}{{end}}</ul>{{end}}
{{- with .Relationships -}}
<h3>Relationships</h3><ul>
{{- range .}}<li><a href="{{.From.URL}}">{{.From.Text}}</a>.{{.FromColumn}} &rarr; <a href="{{.To.URL}}">{{.To.Text}}</a>.{{.ToColumn}}</li>{{end -}}
</ul>
{{- end}}
{{- end}}
{{- end}}

{{define "summary" -}}
<li><a href="{{.URL}}">{{.Name}}</a> <small>{{if .CountFailed}}count failed{{else}}{{.Rows}} rows{{end}}, {{.Columns}} columns</small>{{with .Annotation}} {{.}}{{end}}</li>
{{- end}}
